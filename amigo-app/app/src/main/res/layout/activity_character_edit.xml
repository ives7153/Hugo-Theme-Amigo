<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/card"
        android:title="AI 角色"
        app:titleTextColor="@color/text"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/avatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_avatar"
                    android:scaleType="centerCrop" />
                <TextView
                    android:id="@+id/btn_pick_avatar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/owner_avatar_hint"
                    android:textColor="@color/green"
                    android:textSize="14sp"
                    android:padding="6dp" />
            </LinearLayout>

            <EditText
                android:id="@+id/name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="昵称（如 阿伟）"
                android:background="@drawable/bg_input"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:padding="10dp" />

            <EditText
                android:id="@+id/persona_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="90dp"
                android:gravity="top"
                android:hint="人设（如：毒舌但嘴硬心软的老友）"
                android:background="@drawable/bg_input"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:padding="10dp"
                android:inputType="textMultiLine" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="挚友（每条必回）"
                    android:textColor="@color/text"
                    android:textSize="14sp" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/best_friend_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="活跃度（越高越常出现）"
                android:textColor="@color/muted"
                android:textSize="13sp" />
            <SeekBar
                android:id="@+id/activity_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />
            <TextView
                android:id="@+id/activity_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="60"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="点赞率（刷到但不回复时点赞的概率）"
                android:textColor="@color/muted"
                android:textSize="13sp" />
            <SeekBar
                android:id="@+id/like_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />
            <TextView
                android:id="@+id/like_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20%"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_delete"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_gray_btn"
                android:gravity="center"
                android:text="@string/menu_delete"
                android:textColor="#ff5f5f"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_green_btn"
        android:gravity="center"
        android:text="保存"
        android:textColor="#ffffff"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>